<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Lambda handlers: VideoAnalyzer.Processing::VideoAnalyzer.Processing.Functions::<Method> -->
    <AWSProjectType>Lambda</AWSProjectType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="3.4.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.11" />
    <PackageReference Include="AWSSDK.Rekognition" Version="4.0.101.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoAnalyzer.Core\VideoAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
