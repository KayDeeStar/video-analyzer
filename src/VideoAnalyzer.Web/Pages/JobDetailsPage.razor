@page "/jobs/{JobId}"
@implements IAsyncDisposable
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>@(job?.FileName ?? "Job") · Video Analyzer</PageTitle>

<p><a href="jobs">&larr; All jobs</a></p>

@if (notFound)
{
    <div class="alert alert-warning" role="alert">Job <code>@JobId</code> was not found. It may have expired.</div>
}
else if (job is null)
{
    @if (error is not null)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }
    else
    {
        <p class="text-body-secondary">Loading…</p>
    }
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0 text-break me-2">@job.FileName</h1>
        <span class="badge fs-6 @Format.StatusCss(job.Status)">@job.Status</span>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            @if (videoUrl is not null)
            {
                <video @ref="videoElement" class="w-100 rounded bg-black" controls preload="metadata" src="@videoUrl"></video>
            }
            else
            {
                <div class="video-placeholder rounded">Video not available</div>
            }
        </div>
        <div class="col-lg-5">
            <dl class="row mb-0">
                <dt class="col-sm-4">Job ID</dt>
                <dd class="col-sm-8"><code>@job.JobId</code></dd>
                <dt class="col-sm-4">Size</dt>
                <dd class="col-sm-8">@Format.Bytes(job.FileSize)</dd>
                <dt class="col-sm-4">Uploaded</dt>
                <dd class="col-sm-8">@Format.LocalTime(job.CreatedAt)</dd>
                <dt class="col-sm-4">Last update</dt>
                <dd class="col-sm-8">@Format.LocalTime(job.UpdatedAt)</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex align-items-center mt-4 mb-2">
        <h2 class="h5 mb-0 me-auto">Analysis</h2>
        <div class="d-flex gap-2">
            @if (job.Status is JobStatus.Completed or JobStatus.Failed)
            {
                <button class="btn btn-sm btn-outline-primary" disabled="@reanalyzing" @onclick="ReanalyzeAsync">
                    @(reanalyzing ? "Starting…" : "Analyze again")
                </button>
            }
            @if (result is not null)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Api.ResultsUrl(job.JobId)" target="_blank" rel="noopener">Raw JSON</a>
            }
        </div>
    </div>
    @if (result is not null)
    {
        <AnalysisResults Result="result" OnSeek="SeekAsync" />
    }
    else
    {
    <div class="card">
        <div class="card-body">
            @switch (job.Status)
            {
                case JobStatus.Uploading:
                    <p class="mb-0">The upload has not finished yet.</p>
                    break;
                case JobStatus.Uploaded:
                    <p class="mb-0">Waiting for analysis to start…</p>
                    break;
                case JobStatus.Processing:
                    <p class="mb-0">Analysis in progress. This page refreshes automatically.</p>
                    break;
                case JobStatus.Completed:
                    <p class="mb-0">Loading results…</p>
                    break;
                case JobStatus.Failed:
                    <p class="mb-0 text-danger">@(job.Error ?? "The job failed.")</p>
                    break;
            }
        </div>
    </div>
    }
}

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    [Parameter] public string JobId { get; set; } = "";

    private readonly CancellationTokenSource cts = new();
    private JobDetails? job;
    private AnalysisResult? result;
    private string? videoUrl;
    private string? error;
    private bool notFound;
    private ElementReference videoElement;
    private IJSObjectReference? player;
    private bool reanalyzing;

    protected override async Task OnParametersSetAsync()
    {
        job = null;
        result = null;
        videoUrl = null;
        notFound = false;
        await LoadAsync();
        _ = AutoRefreshAsync(cts.Token);
    }

    private async Task LoadAsync()
    {
        try
        {
            job = await Api.GetJobAsync(JobId, cts.Token);
            notFound = job is null;
            // Keep the first URL: a new pre-signed URL on every refresh would restart the player.
            videoUrl ??= job?.VideoUrl;
            if (job?.Status == JobStatus.Completed && result is null)
                result = await Api.GetResultsAsync(JobId, cts.Token);
            error = null;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = $"Could not load the job: {ex.Message}";
        }
    }

    private async Task AutoRefreshAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (job is not null && !Format.IsFinal(job.Status) && await timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ReanalyzeAsync()
    {
        reanalyzing = true;
        try
        {
            job = await Api.ReanalyzeAsync(JobId, cts.Token);
            result = null;
            error = null;
            _ = AutoRefreshAsync(cts.Token); // the earlier refresh loop stopped when the job finished
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = $"Could not start a new analysis: {ex.Message}";
        }
        finally
        {
            reanalyzing = false;
        }
    }

    private async Task SeekAsync(long ms)
    {
        if (videoUrl is null)
            return;
        player ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/player.js");
        await player.InvokeVoidAsync("seek", videoElement, ms / 1000.0);
    }

    public async ValueTask DisposeAsync()
    {
        cts.Cancel();
        cts.Dispose();
        try
        {
            if (player is not null)
                await player.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
